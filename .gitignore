# ---------------------------------------------------------------
# SVG Area: a single-file static app (no build step required)
# ---------------------------------------------------------------

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors and IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.#*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies (only if you add tooling such as tests or a bundler)
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.npm/
bower_components/

# Build and test output
dist/
build/
out/
coverage/
.nyc_output/
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Temporary and scratch files
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# Local SVG fixtures and exports (keep samples you want to share in /samples/)
svg-area-export*.svg
exports/
samples-private/
private/
*.local.svg

# Archives
*.zip
*.tar
*.tar.gz
*.7z
